  }
 },
 "cond": {
  "class_type": "MiniMaxH3ReferenceToVideo",
  "inputs": {
   "clip": [
    "clip",
    0
   ],
   "vae": [
    "vae_v",
    0
   ],
   "audio_vae": [
    "vae_a",
    0
   ],
   "prompt": "<Picture 1> speaks <d>[ja]こんにちは</d>",
   "width": 832,
   "height": 480,
   "length": 226,
   "ref_image_size": "match",
   "ref_images.ref_image_0": [
    "ref_img_0",
    0
   ],
   "ref_images.ref_image_1": [
    "ref_img_1",
    0
   ],
   "ref_audios.ref_audio_0": [
    "ref_aud_0",
    0
   ]
  }
 },
 "guider": {
  "class_type": "BasicGuider",
  "inputs": {
