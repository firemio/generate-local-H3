    "attn",
    0
   ],
   "conditioning": [
    "cond",
    0
   ]
  }
 },
 "sampler": {
  "class_type": "KSamplerSelect",
  "inputs": {
   "sampler_name": "res_multistep"
  }
 },
 "sigmas": {
  "class_type": "BasicScheduler",
  "inputs": {
   "model": [
    "attn",
    0
   ],
   "scheduler": "simple",
   "steps": 4,
   "denoise": 1.0
  }
 },
 "noise": {
  "class_type": "RandomNoise",
  "inputs": {
   "noise_seed": 7
  }
 },
 "sample": {
  "class_type": "SamplerCustomAdvanced",
  "inputs": {
   "noise": [
    "noise",
    0
   ],
   "guider": [
