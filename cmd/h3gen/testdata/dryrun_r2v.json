    0
   ],
   "sampler": [
    "sampler",
    0
   ],
   "sigmas": [
    "sigmas",
    0
   ],
   "latent_image": [
    "cond",
    1
   ]
  }
 },
 "dec_v": {
  "class_type": "VAEDecode",
  "inputs": {
